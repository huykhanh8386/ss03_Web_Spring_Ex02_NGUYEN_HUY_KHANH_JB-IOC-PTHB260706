package com.example.session03.Models.Repositories;
import com.example.session03.Models.Entities.Instructor;
import org.springframework.stereotype.Repository;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;

@Repository
public class InstructorRepository {
    private List<Instructor> instructors = new ArrayList<>(
                    Arrays.asList(
                            new Instructor(1, "Nguyen Van An", "an@gmail.com"),
                            new Instructor(2, "Tran Thi Ha", "ha@gmail.com"))
            );
    public List<Instructor> findAll() {
        return instructors;
    }
    public Instructor findById(int id) {
        for (Instructor instructor : instructors) {
            if (instructor.getId() == id) {
                return instructor;
            }
        }
        return null;
    }
    public Instructor create(Instructor instructor) {
        if (findById(instructor.getId()) != null) {
            return null;
        }
        instructors.add(instructor);
        return instructor;
    }
    public Instructor update(int id, Instructor newInstructor) {
        Instructor instructor = findById(id);
        if (instructor == null) {
            return null;
        }
        instructor.setName(newInstructor.getName());
        instructor.setEmail(newInstructor.getEmail());
        return instructor;
    }
    public Instructor deleteById(int id) {
        Instructor instructor = findById(id);
        if (instructor == null) {
            return null;
        }
        instructors.remove(instructor);
        return instructor;
    }
}
