package com.example.session03.Models.Repositories;

import com.example.session03.Models.Entities.Course;
import org.springframework.stereotype.Repository;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;

@Repository
public class CourseRepository {
    private List<Course> courses = new ArrayList<>(
                    Arrays.asList(
                            new Course(1, "Java Core", "ACTIVE", 1),
                            new Course(2, "Spring Boot", "ACTIVE", 1),
                            new Course(3, "Database", "ACTIVE", 2)
                    )
            );
    public List<Course> findAll() {
        return courses;
    }
    public Course findById(int id) {
        for (Course course : courses) {
            if (course.getId() == id) {
                return course;
            }
        }
        return null;
    }
    public Course create(Course course) {
        if (findById(course.getId()) != null) {
            return null;
        }
        courses.add(course);
        return course;
    }
    public Course update(int id, Course newCourse) {
        Course course = findById(id);
        if (course == null) {
            return null;
        }
        course.setTitle(newCourse.getTitle());
        course.setStatus(newCourse.getStatus());
        course.setInstructorId(newCourse.getInstructorId());
        return course;
    }
    public Course deleteById(int id) {
        Course course = findById(id);
        if (course == null) {
            return null;
        }
        courses.remove(course);
        return course;
    }
}
