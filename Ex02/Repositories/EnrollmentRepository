package com.example.session03.Models.Repositories;

import com.example.session03.Models.Entities.Enrollment;
import org.springframework.stereotype.Repository;

import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;

@Repository
public class EnrollmentRepository {
    private List<Enrollment> enrollments = new ArrayList<>(
                    Arrays.asList(
                            new Enrollment(1, "Nguyen Huy Khanh", 1),
                            new Enrollment(2, "Tran Van Binh", 1),
                            new Enrollment(3, "Le Thu Ha", 2)
                    )
            );
    public List<Enrollment> findAll() {
        return enrollments;
    }
    public Enrollment findById(int id) {
        for (Enrollment enrollment : enrollments) {
            if (enrollment.getId() == id) {
                return enrollment;
            }
        }
        return null;
    }
    public Enrollment create(Enrollment enrollment) {
        if (findById(enrollment.getId()) != null) {
            return null;
        }
        enrollments.add(enrollment);
        return enrollment;
    }
    public Enrollment update(int id, Enrollment newEnrollment) {
        Enrollment enrollment = findById(id);
        if (enrollment == null) {
            return null;
        }
        enrollment.setStudentName(newEnrollment.getStudentName());
        enrollment.setCourseId(newEnrollment.getCourseId());
        return enrollment;
    }
    public Enrollment deleteById(int id) {
        Enrollment enrollment = findById(id);
        if (enrollment == null) {
            return null;
        }
        enrollments.remove(enrollment);
        return enrollment;
    }
}
